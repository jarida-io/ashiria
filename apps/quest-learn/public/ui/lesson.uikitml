<!--
  Ashiria lesson panel. Panel, Divider, Button and ButtonLabel come from the bundled Horizon kit.
  Element ids are read by src/lesson.ts. Plain ASCII punctuation only.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 380px;
  }

  .panel-content {
    flex-direction: column;
    padding-top: 16px;
    padding-left: 24px;
    padding-right: 24px;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 500;
    color: #5a5a5a;
  }

  .gloss {
    margin-top: 4px;
    font-size: 40px;
    font-weight: 700;
    line-height: 1.1;
    color: #1d1d1f;
  }

  .mode {
    margin-top: 2px;
    margin-bottom: 10px;
    font-size: 13px;
    color: #3a6ea5;
  }

  .status {
    margin-top: 12px;
    font-size: 20px;
    font-weight: 600;
    color: #1d1d1f;
  }

  .hint {
    margin-top: 6px;
    font-size: 15px;
    line-height: 1.3;
    color: #333333;
  }

  .info {
    margin-top: 10px;
    margin-bottom: 8px;
    font-size: 11px;
    color: #7a7a7a;
  }

  .row {
    flex-direction: row;
    gap: 8px;
    padding-left: 24px;
    padding-right: 24px;
    margin-top: 8px;
  }

  .button {
    margin-left: 24px;
    margin-right: 24px;
    margin-top: 12px;
    margin-bottom: 20px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div id="unit" class="eyebrow">Loading signs</div>
    <div id="gloss" class="gloss">Ashiria</div>
    <div id="mode" class="mode">Practise Kenyan Sign Language</div>
    <Divider></Divider>
    <div id="status" class="status">Getting ready</div>
    <div id="hint" class="hint">Raise your hand into the shadow hands to try a sign.</div>
    <div id="info" class="info">Hands: -</div>
  </div>
  <div class="row">
    <Button id="btn-prev"><ButtonLabel id="prev-label">Prev</ButtonLabel></Button>
    <Button id="btn-next"><ButtonLabel id="next-label">Next</ButtonLabel></Button>
    <Button id="btn-mode"><ButtonLabel id="mode-label">Free Sign</ButtonLabel></Button>
  </div>
  <div class="row">
    <Button id="btn-rest"><ButtonLabel id="rest-label">Set rest</ButtonLabel></Button>
    <Button id="btn-hand"><ButtonLabel id="hand-label">Right hand</ButtonLabel></Button>
    <Button id="btn-strict"><ButtonLabel id="strict-label">Normal</ButtonLabel></Button>
  </div>
  <div class="row">
    <Button id="btn-delete"><ButtonLabel id="delete-label">Delete my data</ButtonLabel></Button>
  </div>
  <Button id="xr-button" class="button"><ButtonLabel>Start (hands only)</ButtonLabel></Button>
  <Button id="exit-button" class="button" style="display: none"><ButtonLabel>Exit to browser</ButtonLabel></Button>
</Panel>
